	<item>
		<title><![CDATA[VLOOKUP Masterclass]]></title>
		<link>http://oldsite.local/2024/05/wp-published-post/</link>
		<pubDate>Wed, 01 May 2024 10:00:00 +0000</pubDate>
		<dc:creator><![CDATA[tanvir]]></dc:creator>
